<div class="sources">
<strong>源与口径：</strong>
      现货电价来自“电力现货价格日度”；代理电价来自“代理电价月度钢联”；发电、用电来自“发电用电”；分地区发电来自“分类型分地区”；
      累计装机来自“发电装机容量-wind”；新增装机来自“新增发电装机容量-ifind”；投资来自“电源电网投资”。
      省份净输出来自“输出电量”和“输入电量”，按输出-输入计算；海外电价来自 pb/全球电价.xlsx 的图表公式对应序列。
      储能装机和政策事件先来自项目内 JSON 底表；核电检修来源固定为生态环境部核电运行状态监测页面，后续接入日度/事件级抓取。
      最新数据日期：发电 2026-09-30，总量用电 2026-08-31，分行业用电 2026-08-31，现货电价 2026-10-17，代理电价 2026-10-01，分地区发电 2026-08-31，装机 2026-08-31，交易 2026-08-01，输出/输入电量 2026-08-01/2026-08-01，投资 2026-08-31。
    </div>
</div>
<div class="chart-tooltip global-chart-tooltip" id="global-chart-tooltip"></div>
<script>
  const tabs = Array.from(document.querySelectorAll('.panel-tab'));
  const panels = Array.from(document.querySelectorAll('.report-panel'));
  function activatePanel(target) {
    tabs.forEach((tab) => {
      const active = tab.dataset.target === target;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach((panel) => panel.classList.toggle('active', panel.id === target));
  }
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activatePanel(tab.dataset.target);
      history.replaceState(null, '', '#' + tab.dataset.target);
    });
  });
  const tocLinks = Array.from(document.querySelectorAll('.side-toc a[data-panel]'));
  const tocTargetPanel = Object.fromEntries(tocLinks.map((link) => [link.getAttribute('href').replace('#', ''), link.dataset.panel]));
  function jumpToSubpanel(targetId, panelId) {
    if (!targetId || !panelId) return;
    activatePanel(panelId);
    requestAnimationFrame(() => {
      const target = document.getElementById(targetId);
      if (target) target.scrollIntoView({ behavior:'smooth', block:'start' });
    });
  }
  tocLinks.forEach((link) => {
    link.addEventListener('click', (ev) => {
      ev.preventDefault();
      const targetId = link.getAttribute('href').replace('#', '');
      jumpToSubpanel(targetId, link.dataset.panel);
      history.replaceState(null, '', '#' + targetId);
    });
  });
  const initial = location.hash.replace('#', '');
  if (['overview', 'price', 'supply', 'demand', 'trade'].includes(initial)) activatePanel(initial);
  if (tocTargetPanel[initial]) jumpToSubpanel(initial, tocTargetPanel[initial]);
  function summaryStorageKey(card) {
    return 'power-dashboard-summary:' + (card.dataset.summaryKey || 'default');
  }
  function setSummaryStatus(card, text) {
    const status = card.querySelector('.editable-summary-status');
    if (status) status.textContent = text;
  }
  document.querySelectorAll('.editable-summary-card').forEach((card) => {
    const body = card.querySelector('.editable-summary-body');
    if (!body) return;
    const key = summaryStorageKey(card);
    const saved = localStorage.getItem(key);
    if (saved) {
      body.innerHTML = saved;
      setSummaryStatus(card, '已载入保存稿');
    }
    card.addEventListener('click', (ev) => {
      const button = ev.target.closest ? ev.target.closest('[data-summary-action]') : null;
      if (!button) return;
      const action = button.dataset.summaryAction;
      if (action === 'edit') {
        const enabled = body.getAttribute('contenteditable') === 'true';
        body.setAttribute('contenteditable', enabled ? 'false' : 'true');
        button.textContent = enabled ? '编辑' : '完成编辑';
        if (!enabled) {
          body.focus();
          setSummaryStatus(card, '编辑中');
        } else {
          setSummaryStatus(card, '待保存');
        }
      }
      if (action === 'save') {
        localStorage.setItem(key, body.innerHTML);
        body.setAttribute('contenteditable', 'false');
        const editButton = card.querySelector('[data-summary-action="edit"]');
        if (editButton) editButton.textContent = '编辑';
        setSummaryStatus(card, '已保存 ' + new Date().toLocaleTimeString('zh-CN', { hour12:false }));
      }
      if (action === 'reset') {
        if (!confirm('恢复为本次数据自动生成的汇总文字？')) return;
        localStorage.removeItem(key);
        body.innerHTML = body.dataset.defaultHtml || '';
        body.setAttribute('contenteditable', 'false');
        const editButton = card.querySelector('[data-summary-action="edit"]');
        if (editButton) editButton.textContent = '编辑';
        setSummaryStatus(card, '已恢复生成稿');
      }
      if (action === 'export') {
        const title = card.querySelector('.card-head h3')?.textContent || 'summary';
        const html = '<!doctype html><meta charset="utf-8"><title>' + title + '</title><body>' + body.innerHTML + '</body>';
        const blob = new Blob([html], { type:'text/html;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = '电力月报-汇总编辑稿.html';
        link.click();
        URL.revokeObjectURL(url);
        setSummaryStatus(card, '已导出');
      }
    });
  });
  const globalTip = document.getElementById('global-chart-tooltip');
  function showGlobalTip(ev, text) {
    if (!globalTip || !text) return;
    const rawText = String(text).replace(/\r?\n/g, '\n').replace(/\\n/g, '\n');
    globalTip.innerHTML = rawText
      .split('\n')
      .map((line, idx) => {
        const safe = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return idx === 0 ? `<div class="tip-date">${safe}</div>` : `<div>${safe}</div>`;
      })
      .join('');
    globalTip.style.display = 'block';
    const margin = 16;
    const boxW = globalTip.offsetWidth || 240;
    const boxH = globalTip.offsetHeight || 90;
    let left = ev.clientX + 16;
    let top = ev.clientY - Math.min(40, boxH / 2);
    if (left + boxW + margin > window.innerWidth) left = ev.clientX - boxW - 16;
    if (top + boxH + margin > window.innerHeight) top = window.innerHeight - boxH - margin;
    if (top < margin) top = margin;
    globalTip.style.left = left + 'px';
    globalTip.style.top = top + 'px';
  }
  document.addEventListener('mousemove', (ev) => {
    const target = ev.target.closest ? ev.target.closest('.chart-point[data-tip]') : null;
    if (!target) {
      if (globalTip) globalTip.style.display = 'none';
      return;
    }
    showGlobalTip(ev, target.dataset.tip);
  });
  document.addEventListener('touchstart', (ev) => {
    const target = ev.target.closest ? ev.target.closest('.chart-point[data-tip]') : null;
    const touch = ev.touches && ev.touches[0];
    if (target && touch) showGlobalTip(touch, target.dataset.tip);
  }, { passive:true });
  document.addEventListener('touchmove', (ev) => {
    const target = ev.target.closest ? ev.target.closest('.chart-point[data-tip]') : null;
    const touch = ev.touches && ev.touches[0];
    if (target && touch) showGlobalTip(touch, target.dataset.tip);
  }, { passive:true });
  document.addEventListener('mouseleave', () => {
    if (globalTip) globalTip.style.display = 'none';
  });
</script>
<script id="power-chart-upgrade-runtime">(() => {
  'use strict';
  const states = new Map();
  const palette = ['#17366c','#dc3535','#2f9fb8','#3e9368','#bc833a','#8974b4','#6f7a85'];
  const yearColors = {'2023':'#99a5b6','2024':'#399ccc','2025':'#17366c','2026':'#d93636'};
  const numeric = value => value !== null && value !== '' && Number.isFinite(Number(value));
  const safe = value => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const compact = value => Math.abs(value) >= 100000 ? (value / 10000).toFixed(0)+'万' : Number(value).toLocaleString('zh-CN', {maximumFractionDigits:2});

  function payload(shell) {
    return JSON.parse(shell.querySelector('.power-chart-data').textContent);
  }

  function addYearFilters(state) {
    const box = state.shell.querySelector('.power-chart-years');
    box.replaceChildren();
    if (state.data.mode !== 'timeline' || state.data.yearFilter === false) return;
    const years = [...new Set(state.data.series.flatMap(s => s.points.map(p => /^(\d{4})-/.exec(p.date)?.[1])).filter(Boolean))].sort();
    if (years.length < 2) return;
    state.years = new Set(years);
    for (const year of years) {
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'checkbox'; input.checked = true; input.value = year;
      input.setAttribute('aria-label', '筛选'+year+'年');
      input.addEventListener('change', () => {
        if (input.checked) state.years.add(year); else state.years.delete(year);
        state.saved = null;
        if (state.chart) state.chart.setOption(option(state), {notMerge:true});
      });
      label.append(input, document.createTextNode(year)); box.append(label);
    }
  }

  function option(state) {
    const d = state.data;
    const seasonal = d.mode !== 'timeline';
    const cats = d.categories || [...new Set(d.series.flatMap(s => s.points.map(p => String(p.date))))].sort();
    const categories = cats.filter(date => !state.years || state.years.has(date.slice(0,4)) || !/^\d{4}-/.test(date));
    const narrow = state.shell.clientWidth < 520;
    const colors = d.colors || d.series.map((s,i) => seasonal ? (yearColors[s.label] || palette[i%palette.length]) : palette[i%palette.length]);
    const saved = state.saved;
    const legend = {type:'scroll',top:5,left:8,right:60,icon:'roundRect',itemWidth:16,itemHeight:3,itemGap:12,
      selected:saved?.legend?.[0]?.selected || {},textStyle:{fontSize:narrow?11:12,color:'#253a52'},
      pageIconColor:'#17366c',pageIconSize:10,animation:false};
    const series = d.series.map((s,i) => {
      const points = new Map(s.points.map(p => [String(p.date),p.value]));
      return {name:s.label,type:'line',connectNulls:false,smooth:false,showSymbol:false,symbolSize:4,
        data:categories.map(date => numeric(points.get(date)) ? Number(points.get(date)) : null),
        lineStyle:{width:seasonal && s.label === d.series.at(-1)?.label ? 2.8 : 1.8},
        itemStyle:{color:colors[i]},emphasis:{focus:'series'},animation:false};
    });
    return {animation:false,color:colors,textStyle:{fontFamily:'Microsoft YaHei, sans-serif'},legend,
      grid:{left:narrow?49:62,right:narrow?17:25,top:d.unit?52:44,bottom:69,containLabel:false},
      toolbox:{right:4,top:1,itemSize:13,itemGap:9,feature:{restore:{title:'重置范围和筛选'},saveAsImage:{title:'下载图表',pixelRatio:2}}},
      tooltip:{trigger:'axis',confine:true,appendToBody:false,backgroundColor:'rgba(255,255,255,.97)',borderColor:'#bac8d9',
        textStyle:{fontSize:12,color:'#17304f'},axisPointer:{type:'line',lineStyle:{color:'#71849c',type:'dashed'}},
        formatter(items) { return (items.length?safe(items[0].axisValueLabel):'')+items.filter(p=>numeric(p.data)).map(p=>
          '<br>'+p.marker+safe(p.seriesName)+'：'+Number(p.data).toLocaleString('zh-CN',{minimumFractionDigits:d.digits,maximumFractionDigits:d.digits})+safe(d.unit||'')).join(''); }},
      xAxis:{type:'category',data:categories,boundaryGap:false,axisLine:{lineStyle:{color:'#bac7d7'}},axisTick:{show:false},
        axisLabel:{fontSize:narrow?10:11,color:'#65768c',hideOverlap:true,
          formatter(value) {
            if (d.mode==='daily') return value.replace('-', '/');
            if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value.slice(5);
            if (narrow && /^\d{4}-\d{2}$/.test(value)) return value.slice(2);
            return value;
          }}},
      yAxis:{type:'value',scale:true,name:d.unit||'',nameTextStyle:{fontSize:11,color:'#65768c',align:'left'},
        splitNumber:4,axisLabel:{color:'#65768c',fontSize:narrow?10:11,formatter:compact},
        splitLine:{lineStyle:{color:'#e4ebf3',type:'dashed'}},axisLine:{show:false}},
      dataZoom:[{type:'inside',filterMode:'none',zoomOnMouseWheel:'ctrl',moveOnMouseWheel:false,preventDefaultMouseMove:false,
        start:saved?.dataZoom?.[0]?.start??0,end:saved?.dataZoom?.[0]?.end??100},
        {type:'slider',filterMode:'none',bottom:9,height:19,left:narrow?49:62,right:narrow?17:25,
          start:saved?.dataZoom?.[1]?.start??0,end:saved?.dataZoom?.[1]?.end??100,
          brushSelect:false,borderColor:'#ccd7e5',fillerColor:'rgba(63,120,177,.17)',
          handleSize:'110%',handleStyle:{color:'#fff',borderColor:'#50769f'},textStyle:{fontSize:10,color:'#526b87'},
          dataBackground:{lineStyle:{color:'#9dacc1'},areaStyle:{color:'#e8eef5'}},selectedDataBackground:{lineStyle:{color:'#4a80ac'},areaStyle:{color:'#dce8f3'}}}],series};
  }

  function near(shell) {
    const box = shell.getBoundingClientRect();
    return box.width > 0 && box.height > 0 && box.top < innerHeight+400 && box.bottom > -400;
  }

  function mount(state) {
    if (state.chart || !near(state.shell) || !window.echarts) return;
    state.chart = echarts.init(state.shell.querySelector('.power-chart-canvas'), null, {renderer:'canvas',useDirtyRect:true,devicePixelRatio:Math.min(devicePixelRatio||1,2)});
    state.chart.setOption(option(state));
    state.chart.on('restore', () => {
      state.saved = null;
      if (state.years) {
        state.shell.querySelectorAll('.power-chart-years input').forEach(c=>{c.checked=true;state.years.add(c.value);});
        state.chart.setOption(option(state),{notMerge:true});
      }
    });
    state.shell.dataset.chartReady = 'true';
  }

  function release(state) {
    if (!state.chart) return;
    const o = state.chart.getOption();
    state.saved = {legend:o.legend,dataZoom:o.dataZoom};
    state.chart.dispose();state.chart=null;state.shell.dataset.chartReady='false';
  }

  let scheduled = false;
  function schedule() {
    if (scheduled) return;
    scheduled=true;
    requestAnimationFrame(()=>{
      scheduled=false;
      for (const state of states.values()) {
        if (near(state.shell)) {mount(state);if(state.chart)state.chart.resize();}
        else release(state);
      }
    });
  }

  function register(shell, data) {
    const state={shell,data:data||payload(shell),chart:null,saved:null,years:null};
    states.set(shell,state);addYearFilters(state);
    return state;
  }

  function hydrology() {
    const script=document.getElementById('hydro-data');
    if (!script) return;
    const data=JSON.parse(script.textContent),station=document.getElementById('hydro-station'),mode=document.getElementById('hydro-mode');
    const years=[...new Set(data.dates.map(d=>d.slice(0,4)))].sort();
    const controls=document.getElementById('hydro-years');controls.replaceChildren();
    const chosen=new Set(years);
    for (const year of years) {
      const label=document.createElement('label'),input=document.createElement('input');
      input.type='checkbox';input.checked=true;input.value=year;
      input.addEventListener('change',()=>{if(input.checked)chosen.add(year);else chosen.delete(year);update();});
      label.append(input,document.createTextNode(year));controls.append(label);
    }
    const plots=[...document.querySelectorAll('.hydro-plot')].map(plot=>{
      plot.querySelector('canvas')?.remove();plot.querySelector('output')?.remove();
      const shell=document.createElement('div');shell.className='power-chart-shell';shell.style.setProperty('--power-chart-height','300px');
      shell.innerHTML='<div class="power-chart-years"></div><div class="power-chart-canvas" role="img"></div>';
      plot.append(shell);return {plot,shell,metric:plot.querySelector('h4').textContent,state:null};
    });
    function update() {
      for (const p of plots) {
        if (p.state) {release(p.state);states.delete(p.shell);}
        const metric=data.series.find(s=>s.station===station.value && s.metric===p.metric);
        const seasonal=mode.value==='season';
        const dates=seasonal?Array.from({length:366},(_,i)=>new Date(Date.UTC(2000,0,i+1)).toISOString().slice(5,10)):data.dates.slice(-90);
        const groups=seasonal?years.filter(y=>chosen.has(y)):['近90天'];
        const series=groups.map(year=>({label:year,points:dates.map(date=>{
          const rawDate=seasonal?year+'-'+date:date,index=data.dates.indexOf(rawDate);
          return {date,value:metric && index>=0?metric.values[index]:null};
        })}));
        const d={title:p.metric,mode:seasonal?'daily':'timeline',unit:metric?.unit||'',digits:1,categories:dates,series,yearFilter:false};
        p.state=register(p.shell,d);
      }
      schedule();
    }
    station.addEventListener('change',update);mode.addEventListener('change',update);update();
  }

  function boot() {
    if (!window.echarts) {
      document.querySelectorAll('.power-chart-canvas').forEach(el=>el.textContent='图表资源未加载，请检查 assets/echarts.min.js');
      return;
    }
    document.querySelectorAll('.power-chart-shell').forEach(shell=>register(shell));
    hydrology();
    const observer=new IntersectionObserver(schedule,{rootMargin:'400px'});
    states.forEach(state=>observer.observe(state.shell));
    new MutationObserver(schedule).observe(document.querySelector('main')||document.body,{subtree:true,attributes:true,attributeFilter:['class']});
    window.addEventListener('resize',schedule);window.addEventListener('scroll',schedule,{passive:true});
    document.addEventListener('click',event=>{if(event.target.closest('.panel-tabs,.side-toc,.subpanel-tabs'))schedule();});
    window.powerCharts={states,refresh:schedule};schedule();
  }
  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script></body>
</html>